.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Raw and intermediate data are reproduced by scripts/fetch_*.py.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large locked models are reproducible; keep the small metadata files.
artifacts/models/*
!artifacts/models/.gitkeep

# Local environment
.env
.env.*
*.log
